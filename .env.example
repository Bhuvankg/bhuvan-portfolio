# Server Configuration
PORT=3000
NODE_ENV=development

# Authentication Secrets
JWT_SECRET=gradeai_super_secret_jwt_key_2026_education_platform
JWT_EXPIRES_IN=7d

# Database Configuration (Set DB_TYPE=mysql to use MySQL, or DB_TYPE=sqlite for zero-config embedded SQLite)
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gradeai_db

# AI Auto-Grading Engine (Optional Google Gemini API Key - built-in smart semantic fallback active if empty)
GEMINI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Plagiarism Detection Settings
PLAGIARISM_SIMILARITY_THRESHOLD=25
AUTO_APPROVE_HIGH_CONFIDENCE=false
